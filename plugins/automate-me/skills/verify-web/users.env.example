# Logins for verify-web personas. See personas.md.
# Copy to ~/.config/verify-web/users.env and run: chmod 600 ~/.config/verify-web/users.env
# Never commit the filled-in copy. Fill in what exists; leave a persona blank until a task needs it.
# The key names must match username_env / password_env in .claude/verify-web.yaml.

# Default persona: the first one in the config.
ADMIN_USERNAME=
ADMIN_PASSWORD=

REGULAR_USERNAME=
REGULAR_PASSWORD=

RESTRICTED_USERNAME=
RESTRICTED_PASSWORD=

READONLY_USERNAME=
READONLY_PASSWORD=

# One block per tenant, if your app has them. Copy a block and change the prefix.
# ACME_ADMIN_USERNAME=
# ACME_ADMIN_PASSWORD=
