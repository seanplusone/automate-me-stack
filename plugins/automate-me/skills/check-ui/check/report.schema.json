{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["page", "widths", "verdict"],
  "properties": {
    "page": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["pass", "fail", "review", "inconclusive"] },
    "reason": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "id", "element", "message", "shot"],
        "properties": {
          "width": { "type": "integer" },
          "id": { "type": "string" },
          "element": { "type": "string" },
          "message": { "type": "string" },
          "shot": { "type": "string" }
        }
      }
    },
    "widths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "rules"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "element", "measured", "limit", "message"],
              "properties": {
                "id": { "enum": ["G1", "G2", "G3", "G4", "G9"] },
                "status": { "enum": ["pass", "fail", "skip", "review"] },
                "element": { "type": "string" },
                "measured": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
                "limit": { "type": "object", "additionalProperties": { "type": ["number", "string", "boolean", "null"] } },
                "message": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
