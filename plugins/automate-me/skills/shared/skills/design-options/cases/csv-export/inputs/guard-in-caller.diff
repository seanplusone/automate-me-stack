+<?php
+
+class InvoiceExportController
+{
+    public function export($accountId)
+    {
+        $csv = CsvWriter::download('invoices.csv', ['Number', 'Customer', 'Amount', 'Due']);
+        foreach (Invoice::forAccount($accountId)->cursor() as $invoice) {
+            $csv->row(array_map([$this, 'neutralize'], [$invoice->number, $invoice->customer_name, $invoice->amount, $invoice->due_on]));
+        }
+    }
+
+    private function neutralize($cell)
+    {
+        return in_array(substr((string) $cell, 0, 1), ['=', '+', '-', '@'], true) ? "'" . $cell : $cell;
+    }
+}
