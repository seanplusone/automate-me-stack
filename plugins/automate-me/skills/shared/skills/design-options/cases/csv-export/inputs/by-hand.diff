@@ -0,0 +1,18 @@
+<?php
+
+class InvoiceExportController
+{
+    public function export($accountId)
+    {
+        header('Content-Type: text/csv');
+        header('Content-Disposition: attachment; filename="invoices.csv"');
+        $lines = ['Number,Customer,Amount,Due'];
+        foreach (Invoice::forAccount($accountId)->get() as $invoice) {
+            $cells = [$invoice->number, $invoice->customer_name, $invoice->amount, $invoice->due_on];
+            $lines[] = implode(',', array_map(function ($cell) {
+                return '"' . str_replace('"', '""', $cell) . '"';
+            }, $cells));
+        }
+        echo implode("\n", $lines);
+    }
+}
