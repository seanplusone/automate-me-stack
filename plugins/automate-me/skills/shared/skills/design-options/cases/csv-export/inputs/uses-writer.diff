+<?php
+
+class InvoiceExportController
+{
+    public function export($accountId)
+    {
+        $csv = CsvWriter::download('invoices.csv', ['Number', 'Customer', 'Amount', 'Due']);
+        foreach (Invoice::forAccount($accountId)->cursor() as $invoice) {
+            $csv->row([$invoice->number, $invoice->customer_name, $invoice->amount, $invoice->due_on]);
+        }
+    }
+}
